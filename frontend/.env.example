# Leave empty when the frontend and API share an origin, or when using the
# Vite development proxy. For a separately hosted API, set the full origin,
# for example: https://api.example.edu.cn
VITE_API_BASE_URL=

# Development-only proxy target used by vite.config.ts.
# This value is read by the Vite dev server, not embedded in the browser build.
VITE_API_PROXY_TARGET=http://localhost:8080
# Show pre-filled demo credentials on the login page. This is automatically
# disabled in production builds; set to false in development to hide them too.
VITE_DEMO_MODE=true
