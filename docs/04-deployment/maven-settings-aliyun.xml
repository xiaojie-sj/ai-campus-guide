<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional mirror configuration for faster dependency downloads in mainland
  China. Copy this file to ~/.m2/settings.xml (or %USERPROFILE%\.m2\settings.xml).
  It only changes download endpoints; the dependency set itself is pinned by
  pom.xml plus the Maven Wrapper, so builds stay reproducible on any machine.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>aliyun-central</id>
      <name>Aliyun Maven Central Mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
